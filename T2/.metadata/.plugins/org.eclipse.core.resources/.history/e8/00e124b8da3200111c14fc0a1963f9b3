#include "main.h"
#include "gpio.h"
#include "cmsis_os.h"
extern volatile char f1;
extern volatile char f2;
void Task1(void){
	uint32_t tick_count;
	uint32_t periodo = 100; // 1 tick = 1ms según el CubeMX -> 100 ticks = 100 ms
	while(1){
		tick_count = osKernelGetTickCount() + periodo;
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);
		osDelay(10); // 10
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_RESET);
		osDelayUntil(tick_count);
	}
}
void Task2(void){
	uint32_t tick_count;
	uint32_t periodo = 200; // 1 tick = 1ms según el CubeMX -> 200 ticks = 200 ms
	while(1){
		tick_count = osKernelGetTickCount() + periodo;
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_SET);
		osDelay(20);
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_RESET);
		osDelayUntil(tick_count);
	}
}
void Task3_Carga(void *argument){
    uint32_t tick_count;
    uint32_t periodo = 50; // Despierta cada 50ms para molestar a las otras tareas

    while(1){
        tick_count = osKernelGetTickCount() + periodo;

        // Bucle "dummy" que bloquea la CPU.
        // volatile asegura que el compilador no borre este código inútil.
        for(volatile uint32_t i = 0; i < nivel_de_carga; i++){
            volatile uint32_t calculo_basura = (i * 3) / 2;
            (void)calculo_basura;
        }

        osDelayUntil(tick_count);
    }
}
