#include "main.h"
#include "gpio.h"
#include "cmsis_os.h"
#include <math.h>
extern volatile char f1;
extern volatile char f2;
void Task1(void){
	uint32_t tick_count;
	uint32_t periodo = 100; // 1 tick = 1ms según el CubeMX -> 100 ticks = 100 ms
	while(1){
		tick_count = osKernelGetTickCount() + periodo;
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);
		osDelay(10); // 10
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_RESET);
		osDelayUntil(tick_count);
	}
}
void Task2(void){
	uint32_t tick_count;
	uint32_t periodo = 200; // 1 tick = 1ms según el CubeMX -> 200 ticks = 200 ms
	while(1){
		tick_count = osKernelGetTickCount() + periodo;
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_SET);
		osDelay(20);
		HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_RESET);
		osDelayUntil(tick_count);
	}
}
