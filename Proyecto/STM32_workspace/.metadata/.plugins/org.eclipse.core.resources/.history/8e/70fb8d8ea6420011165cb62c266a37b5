

#include "main.h"
#include "gpio.h"
#include "dac.h"
#include "tim.h"
//extern UART_HandleTypeDef huart1;
//extern DAC_HandleTypeDef hdac1;
//extern TIM_HandleTypeDef htim2;

uint8_t rx_data;
volatile uint8_t modo;
volatile uint16_t contador;
volatile int debouncer=0;

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART2) {
    	// recibo el modo mediante UART
    	// 0x1 = constante con aumento cada boton, ideal para offset
    	// 0x2 = función rampa, ideal para ganancia, DNL e INL
    	// 0x3 = detener
    	// 0x4 = iniciar
    	if(rx_data==0x03){
    		HAL_TIM_Base_Stop_IT(&htim2);
    		HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, 0);
    	}
    	else if(rx_data==0x04){
    		HAL_TIM_Base_Start_IT(&htim2);
    	}
    	else{
        	modo = rx_data;
        	contador = 0;
        	debouncer = 0;
    	}
    	HAL_UART_Receive_IT(&huart2,&rx_data, 1);
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
	if(htim->Instance==TIM2){
        HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, contador);
    }
}
void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef *hdac) {
    if (hdac->Instance == DAC1) {
    	if(modo==0x02){
    		contador++;
    		if(contador>=4096){
    			contador=0;
    		}
    	}
    	else if(modo==0x01){
    		debouncer=0;
    	}
    }
}
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
	if(GPIO_Pin==GPIO_PIN_13){
		if(modo==0x01 && debouncer==0){
			debouncer=1;
			contador++;
			if(contador>=4096){
				contador=0;
			}
		}
	}
}
