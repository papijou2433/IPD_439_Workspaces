#include "main.h"
#include "adc.h"
#include "gpio.h"
#include "dac.h"
volatile uint32_t dac_data = 0;
volatile uint32_t adc_data[4096];
volatile int status = 0;
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
	if(GPIO_Pin==GPIO_PIN_13){
		// se realiza interrupción del boton azul
		if(!status){
			HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, dac_data);
			if(HAL_DAC_GetState(&hdac1)==HAL_DAC_STATE_READY){
				HAL_ADC_Start_IT(&hadc2);
			}
		}
	}
}

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc){
	if(hadc->Instance==ADC2){
		if(dac_data<4095){
			adc_data[dac_data] = HAL_ADC_GetValue(&hadc2);
			dac_data++;
			HAL_DAC_Set_Value(&hdac1,DAC_CHANNEL_1,DAC_ALIGN_12B_R,dac_data);
		}
		else{
			dac_data = 0;
		}

	}
}

