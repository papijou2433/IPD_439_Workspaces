#include "main.h"
#include "adc.h"
#include "gpio.h"
#include "dac.h"
volatile uint32_t dac_data = 0;
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin){
	if(GPIO_Pin==GPIO_PIN_13){
		// se realiza interrupción del boton azul
		HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, dac_data);
		if(HAL_DAC_GetState(&hdac1)==HAL_DAC_STATE_READY){
			HAL_ADC_Start_IT(&hadc2);
		}
	}
}

